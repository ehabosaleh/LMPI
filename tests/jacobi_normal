    }




double calc_diff(double **u, double **u_new, int rows, int cols) {
    double max_diff = 0;
    for (int i=1;i <rows-1;i++) {
        for (int j=1;j<cols-1;j++) {
            double diff=fabs(u_new[i][j]-u[i][j]);
            if (diff>max_diff) {
                max_diff=diff;
            }
        }
    }
    return max_diff;
}


