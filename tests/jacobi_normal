void update_grid(double **u, double **u_new, int rows, int cols) {
    for (int i=2;i< rows-2;i++) {
        for (int j=2; j<cols-2;j++) {
            u_new[i][j]=0.25*(u[i+1][j]+u[i-1][j]+u[i][j+1]+u[i][j-1]);
        }
    }
}


